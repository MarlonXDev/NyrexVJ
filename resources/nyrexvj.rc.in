#include <windows.h>

IDI_APPICON ICON "@NYREXVJ_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@NYREXVJ_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@NYREXVJ_BUILD_NUMBER@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MarlonXDev"
            VALUE "FileDescription", "NyrexVJ"
            VALUE "FileVersion", "@NYREXVJ_VERSION_STRING@"
            VALUE "InternalName", "NyrexVJ"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "NyrexVJ.exe"
            VALUE "ProductName", "NyrexVJ"
            VALUE "ProductVersion", "@NYREXVJ_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
